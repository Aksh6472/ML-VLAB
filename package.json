{
  "name": "ml-vlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run server\"",
    "client": "vite",
    "server": "npm --prefix server run dev",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "vite build && tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.8",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.9",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
