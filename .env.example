# ==========================================
# ML Virtual Lab - Environment Configuration
# ==========================================

# Database Configuration
# In production on Vercel, DATABASE_URL is REQUIRED to connect to a persistent hosted PostgreSQL database
# (such as Neon, Supabase, Vercel Postgres, AWS RDS, etc.).
# In local development, if omitted, the application falls back to local SQLite storage.
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Authentication / JWT
# REQUIRED: A strong, secure secret used for signing and verifying session tokens.
JWT_SECRET=your-production-jwt-secret-here-min-32-chars

# Environment
NODE_ENV=production

# Server Port (Local development only; Vercel manages serverless ports automatically)
PORT=5001

# CORS Configuration (Optional: comma-separated list of allowed production origins)
# Example: https://your-lab.vercel.app
CORS_ORIGIN=https://your-deployment.vercel.app

# Demo Data Seeding (DEVELOPMENT ONLY: Never set to true in production)
# When true in non-production, seeds demo student and teacher accounts.
SEED_DEMO_DATA=false

# SMTP / Email Configuration (Optional: for password reset verification emails)
# If omitted or unconfigured, password reset codes are output to server logs in dev mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM="SRM ML Virtual Lab" <no-reply@srmist.edu.in>
